{
  "expo": {
    "name": "watchudoin?",
    "slug": "wyd",
    "version": "1.0.3",
    "orientation": "portrait",
    "scheme": "watchudoin",
    "icon": "./assets/app-icon-safe.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#141119",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.watchudoin.app"
    },
    "android": {
      "package": "com.watchudoin.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/app-icon-safe.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/app-icon-safe.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#141119"
        }
      ],
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-system-ui",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#6C56C7",
          "defaultChannel": "watchudoin-updates"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow watchudoin? to take moment photos.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow watchudoin? to choose a moment photo.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WydMoment",
              "label": "Wyd? - Your person",
              "description": "A photo moment from your close person, with a quick Nudge.",
              "previewImage": "./assets/widget-preview/wyd-moment.png",
              "minWidth": "280dp",
              "minHeight": "145dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withPrivateWidgetImages",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow watchudoin? to save moment photos to your gallery.",
          "granularPermissions": []
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bbe25d66-2e9a-4e67-87b8-b7f5055685dd"
      }
    },
    "owner": "reverieasy"
  }
}
