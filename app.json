{
  "expo": {
    "name": "watchudoin?",
    "slug": "wyd",
    "version": "1.0.9",
    "orientation": "portrait",
    "scheme": "watchudoin",
    "icon": "./assets/app-icon-safe.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#141119",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.watchudoin.app"
    },
    "android": {
      "package": "com.watchudoin.app",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/app-icon-safe.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/app-icon-safe.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#141119"
        }
      ],
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-system-ui",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6C2CF5",
          "defaultChannel": "watchudoin-updates"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow watchudoin? to take moment photos.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow watchudoin? to choose a moment photo.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WydSmall",
              "label": "watchudoin? - Small",
              "description": "A photo moment and a camera reply in a compact 2 by 2 widget.",
              "previewImage": "./assets/widget-preview/wyd-small.png",
              "minWidth": "130dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WydMedium",
              "label": "watchudoin? - Medium",
              "description": "A photo moment, quick heart, Nudge and camera reply in a 4 by 2 widget.",
              "previewImage": "./assets/widget-preview/wyd-medium.png",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WydLarge",
              "label": "watchudoin? - Large",
              "description": "A larger photo, quick heart, Nudge and camera reply in a 4 by 3 widget.",
              "previewImage": "./assets/widget-preview/wyd-large.png",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withPrivateWidgetImages",
      "./plugins/withWidgetFonts",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow watchudoin? to save moment photos to your gallery.",
          "granularPermissions": []
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bbe25d66-2e9a-4e67-87b8-b7f5055685dd"
      }
    },
    "owner": "reverieasy"
  }
}
